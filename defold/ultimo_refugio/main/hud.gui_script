-- HUD: estadisticas, mensajes, botones tactiles y oscuridad nocturna.
local BTN = {
	{ label = "1 Comer", t = "food" },
	{ label = "2 Beber", t = "drink" },
	{ label = "3 Venda", t = "med" },
}

local function text(self, str, pos, scale, color, pivot)
	local n = gui.new_text_node(pos, str)
	gui.set_font(n, "system_font")
	gui.set_scale(n, vmath.vector3(scale, scale, 1))
	gui.set_color(n, color or vmath.vector4(1, 1, 1, 1))
	gui.set_pivot(n, pivot or gui.PIVOT_NW)
	return n
end

function init(self)
	msg.post(".", "acquire_input_focus")
	local sw, sh = gui.get_width(), gui.get_height()
	-- capa de oscuridad (dia/noche)
	self.dark = gui.new_box_node(vmath.vector3(sw / 2, sh / 2, 0), vmath.vector3(sw, sh, 0))
	gui.set_color(self.dark, vmath.vector4(0.02, 0.03, 0.12, 0))
	gui.set_adjust_mode(self.dark, gui.ADJUST_STRETCH)
	self.stats = text(self, "", vmath.vector3(12, sh - 10, 0), 0.8)
	self.inv = text(self, "", vmath.vector3(12, 18, 0), 0.7, vmath.vector4(0.9, 0.95, 0.8, 1), gui.PIVOT_SW)
	self.msg = text(self, "", vmath.vector3(sw / 2, sh - 70, 0), 0.9, vmath.vector4(1, 0.95, 0.5, 1), gui.PIVOT_N)
	gui.set_xanchor(self.stats, gui.ANCHOR_LEFT); gui.set_yanchor(self.stats, gui.ANCHOR_TOP)
	gui.set_xanchor(self.inv, gui.ANCHOR_LEFT); gui.set_yanchor(self.inv, gui.ANCHOR_BOTTOM)
	gui.set_xanchor(self.msg, gui.ANCHOR_NONE); gui.set_yanchor(self.msg, gui.ANCHOR_TOP)
	self.btn = {}
	for i, b in ipairs(BTN) do
		local box = gui.new_box_node(vmath.vector3(sw - 130 + (i - 1) * 44, 36, 0), vmath.vector3(40, 40, 0))
		gui.set_color(box, vmath.vector4(0, 0, 0, 0.55))
		gui.set_xanchor(box, gui.ANCHOR_RIGHT); gui.set_yanchor(box, gui.ANCHOR_BOTTOM)
		local lbl = gui.new_text_node(vmath.vector3(0, 0, 0), b.label)
		gui.set_font(lbl, "system_font"); gui.set_scale(lbl, vmath.vector3(0.45, 0.45, 1))
		gui.set_parent(lbl, box, false)
		self.btn[i] = { node = box, t = b.t }
	end
end

function on_message(self, message_id, m)
	if message_id ~= hash("state") then return end
	local h = math.floor(m.hour)
	local mn = math.floor((m.hour - h) * 60)
	gui.set_text(self.stats, string.format(
		"Salud %d   Hambre %d   Sed %d\nDia %d  %02d:%02d   Arma: %s   Zombis: %d   Bajas: %d",
		m.hp, m.hunger, m.thirst, m.day, h, mn, m.weapon, m.zombies, m.kills))
	gui.set_text(self.inv, m.inv ~= "" and ("Mochila: " .. m.inv) or "Mochila vacia")
	gui.set_text(self.msg, m.text)
	local c = gui.get_color(self.dark); c.w = m.dark; gui.set_color(self.dark, c)
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		for _, b in ipairs(self.btn) do
			if gui.pick_node(b.node, action.x, action.y) then
				msg.post("/game#game", "use", { t = b.t })
				return true
			end
		end
	end
end
